---
// ClockStage.astro
// Unified component containing Classic, Wall, Flip, Magnifier, and Film clock styles.

// Wall clock mathematical marks and numerals (Trigonometrically exact circular layout)
const wallClockTicks = [];
for (let i = 0; i < 60; i++) {
  const angle = (i * 6 * Math.PI) / 180;
  const isHour = i % 5 === 0;
  const rStart = isHour ? 150 : 158;
  const rEnd = 168;
  const x1 = 200 + rStart * Math.sin(angle);
  const y1 = 200 - rStart * Math.cos(angle);
  const x2 = 200 + rEnd * Math.sin(angle);
  const y2 = 200 - rEnd * Math.cos(angle);
  wallClockTicks.push({ x1, y1, x2, y2, isHour });
}

const wallClockNumbers = [];
for (let i = 1; i <= 12; i++) {
  const angle = (i * 30 * Math.PI) / 180;
  const r = 124; // perfectly equidistant from outer ring on all 360 degrees
  const x = 200 + r * Math.sin(angle);
  const y = 200 - r * Math.cos(angle);
  wallClockNumbers.push({ x, y, val: i });
}

// Programmatic tick generation for the SVG clock face
const classicTicks = [];
for (let i = 0; i < 60; i++) {
  const angle = (i * 6 * Math.PI) / 180;
  const isFive = i % 5 === 0;
  const isQuarter = i % 15 === 0;
  const rStart = isQuarter ? 168 : (isFive ? 174 : 182);
  const rEnd = 190;
  const x1 = 200 + rStart * Math.sin(angle);
  const y1 = 200 - rStart * Math.cos(angle);
  const x2 = 200 + rEnd * Math.sin(angle);
  const y2 = 200 - rEnd * Math.cos(angle);
  classicTicks.push({ x1, y1, x2, y2, isFive, isQuarter });
}

// Generate outer minute numbers (5, 10, 15... 60)
const minuteNumbers = [];
for (let i = 1; i <= 12; i++) {
  const angle = (i * 30 * Math.PI) / 180;
  const r = 150; // radius
  const x = 200 + r * Math.sin(angle);
  const y = 200 - r * Math.cos(angle) + 4.5;
  minuteNumbers.push({ x, y, val: i * 5 });
}

// Generate inner hour numbers (1, 2, 3... 12)
const hourNumbers = [];
for (let i = 1; i <= 12; i++) {
  const angle = (i * 30 * Math.PI) / 180;
  const r = 115; // radius
  const x = 200 + r * Math.sin(angle);
  const y = 200 - r * Math.cos(angle) + 5.5;
  hourNumbers.push({ x, y, val: i });
}

// Generate 24-hour numbers (13, 14, 15... 24)
const hour24Numbers = [];
for (let i = 1; i <= 12; i++) {
  const angle = (i * 30 * Math.PI) / 180;
  const r = 85; // radius
  const x = 200 + r * Math.sin(angle);
  const y = 200 - r * Math.cos(angle) + 4.5;
  const val = i + 12 === 24 ? 24 : i + 12;
  hour24Numbers.push({ x, y, val });
}
---

<div class="clock-stage-wrapper">

  <!-- THEME 1: Classic Pro Analog Clock -->
  <div class="clock-theme-container theme-classic active">
    <div class="classic-clock-box">
      <svg class="classic-analog-svg" viewBox="0 0 400 400" width="100%" height="100%">
        <defs>
          <filter id="classic-hand-shadow" x="-30%" y="-30%" width="160%" height="160%">
            <feDropShadow dx="0.5" dy="2" stdDeviation="2.5" flood-color="#000" flood-opacity="0.25" />
          </filter>
          <filter id="classic-dial-shadow" x="-10%" y="-10%" width="120%" height="120%">
            <feDropShadow dx="0" dy="8" stdDeviation="15" flood-color="#000" flood-opacity="0.1" />
          </filter>
          <linearGradient id="classicHourHandGrad" x1="0%" y1="0%" x2="0%" y2="100%">
            <stop offset="0%" stop-color="var(--hand-hour-color)" />
            <stop offset="100%" stop-color="var(--hand-hour-dark-color)" />
          </linearGradient>
        </defs>

        <!-- Outer Bezel Ring -->
        <circle cx="200" cy="200" r="195" fill="var(--clock-bezel)" stroke="var(--clock-border)" stroke-width="3" filter="url(#classic-dial-shadow)" />
        <!-- Clock Face -->
        <circle cx="200" cy="200" r="190" fill="var(--clock-face)" />

        <!-- Dynamic Highlight Sector (Pie wedge representing remaining time) -->
        <path class="clock-highlight-sector" d="" fill="rgba(var(--brand-accent-rgb), 0.12)" stroke="var(--brand-accent)" stroke-width="1" />

        <!-- Grid / Subdivisions -->
        <circle cx="200" cy="200" r="168" fill="none" stroke="var(--clock-sub-ring)" stroke-dasharray="1 3" stroke-width="0.5" />
        <circle cx="200" cy="200" r="132" fill="none" stroke="var(--clock-sub-ring)" stroke-width="0.5" />

        <!-- Ticks -->
        <g class="clock-ticks">
          {classicTicks.map(t => (
            <line
              x1={t.x1}
              y1={t.y1}
              x2={t.x2}
              y2={t.y2}
              stroke={t.isQuarter ? 'var(--clock-tick-major)' : (t.isFive ? 'var(--clock-tick-medium)' : 'var(--clock-tick-minor)')}
              stroke-width={t.isQuarter ? 2.5 : (t.isFive ? 1.8 : 1)}
              stroke-linecap="round"
            />
          ))}
        </g>

        <!-- Outer Minutes Numbers -->
        <g class="clock-numbers minutes-numbers">
          {minuteNumbers.map(n => (
            <text x={n.x} y={n.y} text-anchor="middle" font-weight="500">{n.val}</text>
          ))}
        </g>

        <!-- Inner 12-Hour Numbers -->
        <g class="clock-numbers hours-numbers">
          {hourNumbers.map(n => (
            <text x={n.x} y={n.y} text-anchor="middle" font-weight="700">{n.val}</text>
          ))}
        </g>

        <!-- Optional Inner 24-Hour Numbers -->
        <g id="clock-24h-numbers" class="clock-numbers hours-24h-numbers hidden">
          {hour24Numbers.map(n => (
            <text x={n.x} y={n.y} text-anchor="middle" font-weight="400">{n.val}</text>
          ))}
        </g>

        <!-- Clock Hands -->
        <!-- Hour Hand -->
        <g id="clock-hour-hand" class="clock-classic-hour" filter="url(#classic-hand-shadow)">
          <path d="M 196 220 L 195 200 L 196 90 L 200 80 L 204 90 L 205 200 L 204 220 Z" fill="url(#classicHourHandGrad)" />
          <circle cx="200" cy="200" r="7" fill="var(--hand-hour-color)" />
        </g>

        <!-- Minute Hand -->
        <g id="clock-minute-hand" class="clock-classic-minute" filter="url(#classic-hand-shadow)">
          <path d="M 197.5 228 L 197 200 L 197.5 55 L 200 45 L 202.5 55 L 203 200 L 202.5 228 Z" fill="var(--hand-minute-color)" />
          <circle cx="200" cy="200" r="5.5" fill="var(--hand-minute-color)" />
        </g>

        <!-- Second Hand -->
        <g id="clock-second-hand" class="clock-classic-second" filter="url(#classic-hand-shadow)">
          <line x1="200" y1="240" x2="200" y2="35" stroke="var(--hand-second-color)" stroke-width="1.5" stroke-linecap="round" />
          <circle cx="200" cy="200" r="4.5" fill="var(--hand-second-color)" />
        </g>

        <!-- Center Red Pivot -->
        <circle cx="200" cy="200" r="8" fill="var(--clock-pivot)" />
        <circle cx="200" cy="200" r="2.5" fill="var(--clock-pivot-dot)" />
      </svg>
    </div>
  </div>

  <!-- THEME 2: Minimalist Wall Clock -->
  <div class="clock-theme-container theme-wall">
    <div class="wall-clock-box">
      <svg class="wall-analog-svg" viewBox="0 0 400 400" width="100%" height="100%">
        <!-- Outer Wall Ring -->
        <circle cx="200" cy="200" r="190" fill="var(--bg-secondary)" stroke="var(--text-primary)" stroke-width="10" />
        <!-- Inner Bezel Ring -->
        <circle cx="200" cy="200" r="176" fill="var(--bg-primary)" stroke="var(--text-primary)" stroke-width="3.5" />

        <!-- 60 Equidistant Ticks -->
        <g class="wall-ticks">
          {wallClockTicks.map(t => (
            <line
              x1={t.x1}
              y1={t.y1}
              x2={t.x2}
              y2={t.y2}
              stroke={t.isHour ? 'var(--text-primary)' : 'var(--text-muted)'}
              stroke-width={t.isHour ? 3.5 : 1.5}
              stroke-linecap="round"
              opacity={t.isHour ? 1 : 0.6}
            />
          ))}
        </g>

        <!-- 12 Equidistant Hour Numerals -->
        <g class="wall-numerals">
          {wallClockNumbers.map(n => (
            <text
              x={n.x}
              y={n.y}
              text-anchor="middle"
              dominant-baseline="central"
              font-family="var(--font-sans)"
              font-size="22"
              font-weight="800"
              fill="var(--text-primary)"
            >
              {n.val}
            </text>
          ))}
        </g>

        <!-- Clock Hands -->
        <!-- Hour Hand -->
        <g id="wall-hour-hand" class="wall-clock-hand hour-hand">
          <line x1="200" y1="220" x2="200" y2="105" stroke="var(--text-primary)" stroke-width="6.5" stroke-linecap="round" />
          <circle cx="200" cy="200" r="6" fill="var(--text-primary)" />
        </g>

        <!-- Minute Hand -->
        <g id="wall-minute-hand" class="wall-clock-hand minute-hand">
          <line x1="200" y1="226" x2="200" y2="60" stroke="var(--text-primary)" stroke-width="4.5" stroke-linecap="round" />
          <circle cx="200" cy="200" r="5" fill="var(--text-primary)" />
        </g>

        <!-- Second Hand -->
        <g id="wall-second-hand" class="wall-clock-hand second-hand">
          <line x1="200" y1="236" x2="200" y2="40" stroke="var(--red-accent)" stroke-width="2" stroke-linecap="round" />
          <circle cx="200" cy="200" r="4.5" fill="var(--red-accent)" />
        </g>

        <!-- Center Pivot Cap -->
        <circle cx="200" cy="200" r="8" fill="var(--text-primary)" />
        <circle cx="200" cy="200" r="3" fill="var(--red-accent)" />
      </svg>
    </div>
  </div>

  <!-- THEME 3: 3D Retro Flip Cards -->
  <div class="clock-theme-container theme-flip">
    <div class="flip-clock-container">
      <div class="flip-countdown">
        <!-- Hours block -->
        <div class="bloc-time hours">
          <span class="count-title">Hours</span>
          <div class="figures-row">
            <div class="figure hours-1">
              <span class="top">0</span>
              <span class="top-back">
                <span>0</span>
              </span>
              <span class="bottom">0</span>
              <span class="bottom-back">
                <span>0</span>
              </span>
            </div>
            <div class="figure hours-2">
              <span class="top">0</span>
              <span class="top-back">
                <span>0</span>
              </span>
              <span class="bottom">0</span>
              <span class="bottom-back">
                <span>0</span>
              </span>
            </div>
          </div>
        </div>
        
        <!-- Colon separator -->
        <div class="flip-colon">
          <span></span>
          <span></span>
        </div>

        <!-- Minutes block -->
        <div class="bloc-time min">
          <span class="count-title">Minutes</span>
          <div class="figures-row">
            <div class="figure min-1">
              <span class="top">0</span>
              <span class="top-back">
                <span>0</span>
              </span>
              <span class="bottom">0</span>
              <span class="bottom-back">
                <span>0</span>
              </span>
            </div>
            <div class="figure min-2">
              <span class="top">0</span>
              <span class="top-back">
                <span>0</span>
              </span>
              <span class="bottom">0</span>
              <span class="bottom-back">
                <span>0</span>
              </span>
            </div>
          </div>
        </div>
        
        <!-- Colon separator -->
        <div class="flip-colon">
          <span></span>
          <span></span>
        </div>

        <!-- Seconds block -->
        <div class="bloc-time sec">
          <span class="count-title">Seconds</span>
          <div class="figures-row">
            <div class="figure sec-1">
              <span class="top">0</span>
              <span class="top-back">
                <span>0</span>
              </span>
              <span class="bottom">0</span>
              <span class="bottom-back">
                <span>0</span>
              </span>
            </div>
            <div class="figure sec-2">
              <span class="top">0</span>
              <span class="top-back">
                <span>0</span>
              </span>
              <span class="bottom">0</span>
              <span class="bottom-back">
                <span>0</span>
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- THEME 4: Magnifying Glass Canvas -->
  <div class="clock-theme-container theme-magnifier">
    <div class="magnifier-clock-container">
      <canvas class="magnifier-clock-canvas" width="380" height="380"></canvas>
    </div>
  </div>

  <!-- THEME 5: Retro Film Countdown -->
  <div class="clock-theme-container theme-film">
    <div class="film-clock-container">
      <svg class="exam-film-clock" viewBox="0 0 400 400" width="100%" height="100%">
        <defs>
          <radialGradient id="filmGradient" cx="200" cy="200" r="160" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="var(--bg-secondary)"/>
            <stop offset="0.6" stop-color="var(--bg-tertiary)"/>
            <stop offset="1" stop-color="var(--border-color)"/>
          </radialGradient>
        </defs>
        <!-- Background card -->
        <rect width="380" height="380" x="10" y="10" rx="20" ry="20" fill="url(#filmGradient)" stroke="var(--border-color)" stroke-width="2" />
        
        <!-- SVG highlight sector (pie slice) -->
        <path class="clock-highlight-sector" d="" fill="rgba(var(--brand-accent-rgb), 0.15)" stroke="var(--brand-accent)" stroke-width="1.5" />

        <!-- Outer concentric circles -->
        <circle cx="200" cy="200" r="160" fill="none" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.25" />
        <circle cx="200" cy="200" r="140" fill="none" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.4" />
        <circle cx="200" cy="200" r="110" fill="none" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.65" />
        
        <!-- Crosshairs lines -->
        <line x1="40" y1="200" x2="360" y2="200" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.35" />
        <line x1="200" y1="40" x2="200" y2="360" stroke="var(--text-muted)" stroke-width="1.5" opacity="0.35" />
        
        <!-- Rotating sweep arm -->
        <line id="film-rotator" x1="200" y1="200" x2="200" y2="40" stroke="var(--text-primary)" stroke-width="2.5" class="film-arm" />
        
        <!-- Countdown digit display -->
        <text id="film-counter" x="200" y="240" text-anchor="middle" fill="var(--brand-accent)" font-family="var(--font-sans)" font-size="130" font-weight="700">8</text>
      </svg>
    </div>
  </div>

</div>

<style>
  .clock-stage-wrapper {
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    position: relative;
    user-select: none;
  }

  .clock-theme-container {
    display: none;
    width: 100%;
    height: 100%;
  }

  .clock-theme-container.active {
    display: block;
  }

  /* CLASSIC ANALOG CLOCK FACE SCOPED STYLES */
  .classic-clock-box {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .classic-analog-svg {
    display: block;
    width: 100%;
    height: 100%;
    transform: translate3d(0, 0, 0);
  }

  .clock-numbers {
    font-family: var(--font-sans);
    fill: var(--text-muted);
  }

  .minutes-numbers {
    font-size: 10.5px;
    fill: var(--text-muted);
    opacity: 0.65;
  }

  .hours-numbers {
    font-size: 18px;
    fill: var(--text-primary);
  }

  .hours-24h-numbers {
    font-size: 9px;
    fill: var(--brand-accent);
    opacity: 0.85;
    transition: opacity 0.3s ease;
  }



  /* WALL CLOCK FACE SCOPED STYLES */
  .wall-clock-box {
    width: 100%;
    max-width: 320px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border-radius: 50%;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
  }

  .wall-analog-svg {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
  }

  /* 3D RETRO FLIP CARDS SCOPED STYLES */
  .flip-clock-container {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem 0;
    user-select: none;
  }

  .flip-countdown {
    display: flex;
    gap: 0.5rem;
    align-items: flex-start;
    justify-content: center;
  }

  .flip-countdown .bloc-time {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
    text-align: center;
  }

  .flip-countdown .figures-row {
    display: flex;
    flex-direction: row;
    gap: 5px;
  }

  .flip-countdown .count-title {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Colon separator between time units */
  .flip-colon {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding-top: 1.6rem;
    height: 96px;
  }

  .flip-colon span {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--brand-accent);
    animation: colonPulse 1s ease-in-out infinite alternate;
  }

  .flip-colon span:nth-child(2) {
    animation-delay: 0.5s;
  }

  @keyframes colonPulse {
    0% { opacity: 1; }
    100% { opacity: 0.3; }
  }

  .flip-countdown .figure {
    position: relative;
    height: 96px;
    width: 64px;
    background-color: var(--bg-secondary);
    border-radius: 8px;
    box-shadow:
      0 4px 12px 0 rgba(0, 0, 0, 0.25),
      inset 0 1px 0 0 rgba(255, 255, 255, 0.1);
  }

  .flip-countdown .figure > span {
    position: absolute;
    left: 0;
    right: 0;
    margin: auto;
    font-family: var(--font-mono);
    font-size: 3.6rem;
    font-weight: 700;
    color: var(--brand-accent);
    text-align: center;
    line-height: 96px;
  }

  /* Center horizontal cut line */
  .flip-countdown .figure .top::after,
  .flip-countdown .figure .bottom-back::after {
    content: "";
    position: absolute;
    z-index: -1;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    border-bottom: 1px solid rgba(0, 0, 0, 0.25);
  }

  /* Top Card (Front, flips down) */
  .flip-countdown .figure .top {
    z-index: 3;
    background-color: var(--bg-tertiary);
    transform-origin: 50% 100%;
    -webkit-transform-origin: 50% 100%;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    transform: perspective(300px);
    -webkit-transform: perspective(300px);
  }

  /* Bottom Card (Static Background) */
  .flip-countdown .figure .bottom {
    z-index: 1;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
  }

  .flip-countdown .figure .bottom::before {
    content: "";
    position: absolute;
    display: block;
    top: 0;
    left: 0;
    width: 100%;
    height: 50%;
    background-color: rgba(0, 0, 0, 0.05);
  }

  /* Bottom Back (Top half behind top, revealed as top flips) */
  .flip-countdown .figure .bottom-back {
    z-index: 2;
    top: 0;
    height: 50%;
    overflow: hidden;
    background-color: var(--bg-tertiary);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
  }

  .flip-countdown .figure .bottom-back span {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    margin: auto;
  }

  /* Common clipping for top and top-back */
  .flip-countdown .figure .top,
  .flip-countdown .figure .top-back {
    height: 50%;
    overflow: hidden;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }

  /* Top Back (Bottom half that starts folded up at 180deg and flips down to 0deg) */
  .flip-countdown .figure .top-back {
    z-index: 4;
    bottom: 0;
    background-color: var(--bg-secondary);
    -webkit-transform-origin: 50% 0;
    transform-origin: 50% 0;
    transform: perspective(300px) rotateX(180deg);
    -webkit-transform: perspective(300px) rotateX(180deg);
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
  }

  .flip-countdown .figure .top-back span {
    position: absolute;
    top: -100%;
    left: 0;
    right: 0;
    margin: auto;
  }

  /* Responsive 3D Flip Cards for Mobile & Tablet */
  @media (max-width: 540px) {
    .flip-countdown {
      gap: 0.25rem;
    }

    .flip-countdown .figures-row {
      gap: 3px;
    }

    .flip-countdown .figure {
      height: 64px;
      width: 44px;
      border-radius: 6px;
    }

    .flip-countdown .figure > span {
      font-size: 2.3rem;
      line-height: 64px;
    }

    .flip-colon {
      height: 64px;
      padding-top: 1.2rem;
      gap: 10px;
    }

    .flip-colon span {
      width: 6px;
      height: 6px;
    }
  }

  @media (max-width: 380px) {
    .flip-countdown .figure {
      height: 52px;
      width: 36px;
      border-radius: 5px;
    }

    .flip-countdown .figure > span {
      font-size: 1.85rem;
      line-height: 52px;
    }

    .flip-colon {
      height: 52px;
      padding-top: 1rem;
      gap: 8px;
    }

    .flip-colon span {
      width: 5px;
      height: 5px;
    }
  }

  /* MAGNIFIER CLOCK SCOPED STYLES */
  .magnifier-clock-container {
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .magnifier-clock-canvas {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* FILM COUNTDOWN CLOCK SCOPED STYLES */
  .film-clock-container {
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .exam-film-clock {
    display: block;
    width: 100%;
    height: 100%;
  }



  .hidden {
    display: none !important;
  }
</style>
