---
// ProgressDisplay.astro
---

<div class="progress-display-card">
  <!-- Progress Metadata Headers -->
  <div class="progress-header">
    <div class="progress-title-block">
      <span class="progress-label">Exam Progress</span>
      <span id="metric-percent" class="progress-percentage-val">100% Remaining</span>
    </div>
    <span id="metric-end-time" class="end-time-badge">Ends at --:-- --</span>
  </div>

  <!-- Linear Progress Bar -->
  <div class="progress-bar-container">
    <div id="progress-bar-fill" class="progress-bar-fill" style="width: 100%;"></div>
  </div>

  <!-- Detailed Metric Grid -->
  <div class="metrics-grid">
    <div class="metric-box">
      <span class="metric-label">Elapsed</span>
      <span id="metric-elapsed" class="metric-value">00:00:00</span>
    </div>
    <div class="metric-box">
      <span class="metric-label">Remaining</span>
      <span id="metric-remaining" class="metric-value text-accent">00:00:00</span>
    </div>
    <div class="metric-box">
      <span class="metric-label">Total</span>
      <span id="metric-total" class="metric-value">00:00:00</span>
    </div>
  </div>
</div>

<style>
  .progress-display-card {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    width: 100%;
  }

  .progress-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .progress-title-block {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .progress-label {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .progress-percentage-val {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .end-time-badge {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--brand-accent);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.35rem 0.65rem;
    border-radius: 0.5rem;
  }

  /* Linear Progress Bar */
  .progress-bar-container {
    width: 100%;
    height: 8px;
    background: var(--bg-secondary);
    border-radius: 4px;
    overflow: hidden;
    position: relative;
    border: 1px solid var(--border-color);
  }

  .progress-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--brand-accent-glow) 0%, var(--brand-accent) 100%);
    border-radius: 4px;
    width: 100%;
    transition: width 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    box-shadow: 0 0 8px var(--brand-accent-glow);
  }

  /* Metrics Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    padding: 0.75rem;
    border-radius: 0.75rem;
  }

  .metric-box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.25rem;
  }

  .metric-box:not(:last-child) {
    border-right: 1px solid var(--border-color);
  }

  .metric-label {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .metric-value {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .metric-value.text-accent {
    color: var(--brand-accent);
  }

  /* Critical state overrides inside script context */
  .progress-display-card.critical .progress-bar-fill {
    background: linear-gradient(90deg, var(--red-accent) 0%, #ff6b6b 100%);
    box-shadow: 0 0 10px rgba(239, 68, 68, 0.5);
  }

  .progress-display-card.critical .metric-value.text-accent,
  .progress-display-card.critical .end-time-badge {
    color: var(--red-accent);
  }
</style>
