---
// SettingsPanel.astro
---

<div id="settings-drawer-backdrop" class="drawer-backdrop hidden">
  <div id="settings-drawer" class="settings-drawer">
    
    <!-- Header -->
    <div class="drawer-header">
      <div class="drawer-title">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        <h3>Settings Panel</h3>
      </div>
      <button type="button" id="settings-close-btn" class="close-btn" aria-label="Close settings drawer">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <!-- Body Scroll Area -->
    <div class="drawer-body">
      
      <!-- Theme & Layout Section -->
      <div class="drawer-section">
        <h4 class="section-title">Visual Preference</h4>
        <div class="setting-item">
          <div class="setting-info">
            <span class="setting-label">Dark Theme</span>
            <span class="setting-desc">Switch between Light and Dark interface colors</span>
          </div>
          <label class="switch-toggle">
            <input type="checkbox" id="settings-theme-toggle" />
            <span class="slider"></span>
          </label>
        </div>
      </div>

      <!-- Clock Modes -->
      <div class="drawer-section">
        <h4 class="section-title">Analog Clock Behavior</h4>
        <div class="setting-item flex-col">
          <div class="setting-info">
            <span class="setting-label">Clock Representation</span>
            <span class="setting-desc">Define what the analog hands display</span>
          </div>
          <select id="settings-clock-rep" class="select-input">
            <option value="remaining">Remaining Exam Time</option>
            <option value="elapsed">Elapsed Exam Time</option>
            <option value="wall">Current Wall Clock Time</option>
          </select>
        </div>

        <div class="setting-item flex-col">
          <div class="setting-info">
            <span class="setting-label">Clock Theme / Style</span>
            <span class="setting-desc">Choose your preferred visual clock layout</span>
          </div>
          <select id="settings-clock-theme" class="select-input">
            <option value="classic">Classic Pro Analog</option>
            <option value="wall">Minimalist Wall Clock</option>
            <option value="flip">3D Retro Flip Cards</option>
            <option value="magnifier">Magnifying Glass Canvas</option>
            <option value="film">Retro Film Countdown</option>
          </select>
        </div>

        <div class="setting-item">
          <div class="setting-info">
            <span class="setting-label">Show Seconds Hand</span>
            <span class="setting-desc">Render the sweeping red seconds needle</span>
          </div>
          <label class="switch-toggle">
            <input type="checkbox" id="settings-show-seconds" checked />
            <span class="slider"></span>
          </label>
        </div>

        <div class="setting-item">
          <div class="setting-info">
            <span class="setting-label">Show 24-Hour Markings</span>
            <span class="setting-desc">Add inner 24-hour numbers on the clock face</span>
          </div>
          <label class="switch-toggle">
            <input type="checkbox" id="settings-show-24h" />
            <span class="slider"></span>
          </label>
        </div>
      </div>

      <!-- Volume settings -->
      <div class="drawer-section">
        <h4 class="section-title">Audio Notifications</h4>
        <div class="setting-item">
          <div class="setting-info">
            <span class="setting-label">Enable Warning Sound</span>
            <span class="setting-desc">Synthesizer warning beep play when milestones hit</span>
          </div>
          <label class="switch-toggle">
            <input type="checkbox" id="settings-sound-enabled" checked />
            <span class="slider"></span>
          </label>
        </div>

        <div class="setting-item flex-col" id="volume-control-wrapper">
          <div class="setting-info flex-row">
            <span class="setting-label">Alert Volume</span>
            <span id="volume-indicator-val" class="volume-val">50%</span>
          </div>
          <div class="volume-slider-wrapper">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon></svg>
            <input type="range" id="settings-volume" min="0" max="100" value="50" class="range-slider" />
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon><path d="M19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"></path></svg>
          </div>
        </div>

        <!-- Alarm Sound Choice -->
        <div class="setting-item flex-col">
          <div class="setting-info">
            <span class="setting-label">Completion Alarm Sound</span>
            <span class="setting-desc">Select the audio sound played when time runs out</span>
          </div>
          <div class="sound-select-row">
            <select id="settings-alarm-sound" class="select-input sound-dropdown">
              <option value="classic">🔔 Classic Exam Chime (Ding-Dong)</option>
              <option value="digital">⏱️ Digital Electronic Beeps</option>
              <option value="school-bell">🏫 Traditional School Bell</option>
              <option value="emergency">🚨 Urgent Alarm Siren</option>
              <option value="gentle-gong">🧘 Deep Resonating Gong</option>
              <option value="triple-fanfare">🎺 Triumphant Fanfare Flourish</option>
            </select>
            <button type="button" id="btn-preview-alarm-sound" class="btn-preview-sound" title="Preview Sound">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <span>Test</span>
            </button>
          </div>
        </div>
      </div>

      <!-- Custom Warning Alerts -->
      <div class="drawer-section">
        <h4 class="section-title">Milestone Alerts</h4>
        <p class="section-desc-para">Set the remaining time (in minutes) when you want a visual flash and warning chime.</p>
        
        <div class="warning-add-form">
          <input type="number" id="warning-minutes-input" min="1" max="600" placeholder="e.g. 20" />
          <button type="button" id="btn-add-warning" class="btn-sub-action">Add Alert</button>
        </div>

        <div class="warnings-list" id="settings-warnings-list">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- General Defaults -->
      <div class="drawer-footer-actions">
        <button type="button" id="btn-reset-settings" class="btn-reset-action">Reset to Defaults</button>
      </div>

    </div>
  </div>
</div>

<style>
  /* Drawer backdrop */
  .drawer-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    z-index: 1000;
    display: flex;
    justify-content: flex-end;
    transition: opacity 0.3s ease;
  }

  .drawer-backdrop.hidden {
    opacity: 0;
    pointer-events: none;
  }

  /* Drawer panel sliding in */
  .settings-drawer {
    width: 100%;
    max-width: 360px;
    height: 100%;
    background: var(--bg-tertiary);
    border-left: 1px solid var(--border-color);
    box-shadow: -8px 0 32px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    transform: translateX(0);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .drawer-backdrop.hidden .settings-drawer {
    transform: translateX(100%);
  }

  /* Header */
  .drawer-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-color);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .drawer-title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .drawer-title h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .drawer-title .icon {
    color: var(--brand-accent);
  }

  .close-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem;
    border-radius: 0.25rem;
    display: flex;
    align-items: center;
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .close-btn:hover {
    color: var(--text-primary);
    background: var(--bg-secondary);
  }

  /* Body settings lists */
  .drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .drawer-section {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .section-title {
    margin: 0 0 0.25rem;
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--text-muted);
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--border-color);
    padding-bottom: 0.35rem;
  }

  .section-desc-para {
    margin: 0;
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .setting-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .setting-item.flex-col {
    flex-direction: column;
    align-items: stretch;
    gap: 0.5rem;
  }

  .setting-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .setting-info.flex-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
  }

  .setting-label {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-primary);
  }

  .setting-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Select and Slider Elements */
  .select-input {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.5rem;
    font-family: inherit;
    font-size: 0.85rem;
    border-radius: 0.5rem;
    outline: none;
    cursor: pointer;
    width: 100%;
  }

  .select-input:focus {
    border-color: var(--brand-accent);
  }

  .volume-val {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--brand-accent);
  }

  .volume-slider-wrapper {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .volume-slider-wrapper .icon {
    color: var(--text-muted);
  }

  .range-slider {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    background: var(--bg-secondary);
    border-radius: 3px;
    outline: none;
  }

  .range-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--brand-accent);
    cursor: pointer;
    transition: transform 0.1s ease;
  }

  .range-slider::-webkit-slider-thumb:hover {
    transform: scale(1.2);
  }

  /* Warning Form */
  .warning-add-form {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.5rem;
  }

  .warning-add-form input {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    padding: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.9rem;
    border-radius: 0.5rem;
    outline: none;
  }

  .warning-add-form input:focus {
    border-color: var(--brand-accent);
  }

  .btn-sub-action {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    padding: 0.5rem 0.85rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-sub-action:hover {
    background: var(--bg-tertiary);
    border-color: var(--text-muted);
  }

  /* Warnings lists tags */
  .warnings-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    min-height: 32px;
    align-items: center;
  }

  .warning-tag {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 0.4rem;
    display: flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-primary);
    overflow: hidden;
  }

  .warning-tag-label {
    padding: 0.25rem 0.4rem 0.25rem 0.5rem;
  }

  .warning-tag-delete {
    background: transparent;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0.25rem 0.4rem;
    display: flex;
    align-items: center;
    border-left: 1px solid var(--border-color);
    transition: color 0.2s ease, background-color 0.2s ease;
  }

  .warning-tag-delete:hover {
    color: var(--red-accent);
    background: rgba(239, 68, 68, 0.05);
  }

  /* Footer Actions */
  .drawer-footer-actions {
    margin-top: 1rem;
    border-top: 1px solid var(--border-color);
    padding-top: 1.25rem;
  }

  .btn-reset-action {
    width: 100%;
    background: transparent;
    border: 1px dashed var(--red-accent);
    color: var(--red-accent);
    padding: 0.65rem;
    border-radius: 0.5rem;
    font-family: inherit;
    font-weight: 500;
    font-size: 0.85rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-reset-action:hover {
    background: rgba(239, 68, 68, 0.05);
  }

  /* Toggle Switch */
  .switch-toggle {
    position: relative;
    display: inline-block;
    width: 40px;
    height: 22px;
    flex-shrink: 0;
  }

  .switch-toggle input {
    opacity: 0;
    width: 0;
    height: 0;
  }

  .slider {
    position: absolute;
    cursor: pointer;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: var(--border-color);
    transition: 0.2s;
    border-radius: 22px;
  }

  .slider:before {
    position: absolute;
    content: "";
    height: 14px;
    width: 14px;
    left: 4px;
    bottom: 4px;
    background-color: white;
    transition: 0.2s;
    border-radius: 50%;
  }

  .switch-toggle input:checked + .slider {
    background-color: var(--brand-accent);
  }

  .switch-toggle input:checked + .slider:before {
    transform: translateX(18px);
  }

  /* Sound Selector & Preview */
  .sound-select-row {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    width: 100%;
    margin-top: 0.25rem;
  }

  .sound-dropdown {
    flex: 1;
  }

  .btn-preview-sound {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.95rem;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    border-radius: 0.5rem;
    color: var(--brand-accent);
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-preview-sound:hover {
    background: var(--brand-accent);
    color: #ffffff;
    border-color: var(--brand-accent);
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(var(--brand-accent-rgb), 0.25);
  }

  .btn-preview-sound:active {
    transform: translateY(0);
  }
</style>
