<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
		<link rel="icon" type="image/svg+xml" href="/icon.svg" />
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#0a0a0c" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<meta name="generator" content={Astro.generator} />
		<title>Exam Clock & Timer — Professional Visual Time Manager</title>
		
		<!-- Preconnect to Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- Fonts: Outfit (headings/UI) & JetBrains Mono (monospaced timer) -->
		<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

		<!-- Fast Theme Initialize Script (Prevents white flashes) -->
		<script is:inline>
			(function () {
				const theme = localStorage.getItem('exam-clock-theme');
				if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
					document.documentElement.classList.add('dark');
					document.querySelector('meta[name="theme-color"]').setAttribute('content', '#0a0a0c');
				} else {
					document.documentElement.classList.remove('dark');
					document.querySelector('meta[name="theme-color"]').setAttribute('content', '#f8fafc');
				}
			})();
		</script>
	</head>
	<body>
		<slot />

		<!-- Register PWA Service Worker -->
		<script>
			if ('serviceWorker' in navigator) {
				window.addEventListener('load', () => {
					navigator.serviceWorker.register('/sw.js')
						.then((reg) => console.log('ServiceWorker registered successfully:', reg.scope))
						.catch((err) => console.error('ServiceWorker registration failed:', err));
				});
			}
		</script>
	</body>
</html>

<style is:global>
	:root {
		--font-sans: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
		--font-mono: 'JetBrains Mono', 'Courier New', monospace;
	}

	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		height: 100%;
		font-family: var(--font-sans);
		overflow: hidden; /* Main window is non-scrolling, uses layout panels */
		background-color: var(--bg-primary);
		color: var(--text-primary);
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	*, *::before, *::after {
		box-sizing: border-box;
	}

	/* Custom Scrollbar for inner panel lists */
	::-webkit-scrollbar {
		width: 6px;
		height: 6px;
	}
	::-webkit-scrollbar-track {
		background: transparent;
	}
	::-webkit-scrollbar-thumb {
		background: rgba(148, 163, 184, 0.3);
		border-radius: 4px;
	}
	::-webkit-scrollbar-thumb:hover {
		background: rgba(148, 163, 184, 0.5);
	}
</style>
