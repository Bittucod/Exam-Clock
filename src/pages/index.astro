    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    max-width: 440px;
  }

  .entry-clock-orb {
    position: relative;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--bg-secondary);
    border: 2px solid var(--border-color);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--brand-accent);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }

  .entry-orb-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 2px dashed rgba(var(--brand-accent-rgb), 0.35);
    animation: orbSpin 24s linear infinite;
  }

  .entry-orb-glow {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(var(--brand-accent-rgb), 0.25) 0%, transparent 70%);
    animation: orbPulse 3s ease-in-out infinite alternate;
  }

  @keyframes orbSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  @keyframes orbPulse {
    from { transform: scale(0.9); opacity: 0.5; }
    to { transform: scale(1.15); opacity: 1; }
  }

  .entry-badge-pill {
    font-size: 0.75rem;
    font-weight: 700;
