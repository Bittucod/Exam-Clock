---
import Layout from '../layouts/Layout.astro';
import ClockStage from '../components/ClockStage.astro';
import TimerSetup from '../components/TimerSetup.astro';
import TimerControls from '../components/TimerControls.astro';
import ProgressDisplay from '../components/ProgressDisplay.astro';
import QuestionProgress from '../components/QuestionProgress.astro';
import SettingsPanel from '../components/SettingsPanel.astro';
import HistoryPanel from '../components/HistoryPanel.astro';
import ThemeModal from '../components/ThemeModal.astro';
import SiteFooter from '../components/SiteFooter.astro';
---

<Layout>
  <!-- Main Grid Layout -->
  <div class="app-viewport">
    
    <!-- Top Header -->
    <header class="app-header glass-panel">
      <div class="header-logo-section">
        <div class="logo-icon-wrapper">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
        </div>
        <div class="logo-text">
          <h1>Exam Clock</h1>
          <span class="logo-badge">Pro Edition</span>
        </div>
      </div>
      
      <!-- System Wall Clock & Date (Highly Visual) -->
      <div class="system-time-display" id="system-time-display">
        <span class="sys-date" id="sys-date">Wednesday, August 19</span>
        <span class="sys-time" id="sys-time">11:32 AM</span>
      </div>

      <!-- Desktop Site Navigation Links -->
      <nav class="app-nav-links" aria-label="Explore Exam Timer Resources">
        <a href="/how-it-works" class="app-nav-item">How It Works</a>
        <a href="/features" class="app-nav-item">Features</a>
        <a href="/guide" class="app-nav-item">Guides</a>
        <a href="/comparisons" class="app-nav-item">Comparisons</a>
        <a href="/faq" class="app-nav-item">FAQ</a>
      </nav>

      <!-- Action Toggles -->
      <div class="header-actions">
        <!-- Prominent Visual Themes Gallery Button -->
        <button type="button" id="header-theme-btn" class="header-action-btn secondary theme-action-btn" title="Open Visual Clock Themes Gallery" aria-label="Clock Themes">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" class="theme-btn-svg">
            <circle cx="13.5" cy="6.5" r="1.5" fill="currentColor"></circle>
            <circle cx="17.5" cy="10.5" r="1.5" fill="currentColor"></circle>
            <circle cx="8.5" cy="7.5" r="1.5" fill="currentColor"></circle>
            <circle cx="6.5" cy="12.5" r="1.5" fill="currentColor"></circle>
            <path d="M12 2C6.5 2 2 6.5 2 12a10 10 0 0 0 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 0 1 1.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2z"></path>
          </svg>
          <span class="theme-btn-label">Themes</span>
        </button>

        <!-- Compact Icon-Based History Button -->
        <button type="button" id="header-history-btn" class="header-action-btn secondary icon-only-action" title="View past exam session logs" aria-label="Session History">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="10"></circle></svg>
        </button>
        
        <!-- Compact Icon-Based Settings & Audio Button -->
        <button type="button" id="header-settings-btn" class="header-action-btn secondary icon-only-action" title="Audio & Alarm Settings" aria-label="Settings">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </button>
      </div>
    </header>

    <!-- Main Dynamic Body -->
    <!-- Main Dynamic Body -->
    <main class="app-main-content">
      
      <!-- SCREEN 1: Setup / Welcome Landing Page (Top Priority: Configure New Session) -->
      <section id="screen-setup" class="setup-screen-layout active">
        <!-- 1. PRIMARY HERO FOCUS: Directly Accessible Setup Panel (Top on all devices) -->
        <div class="setup-panel">
          <TimerSetup />
        </div>

        <!-- 2. SECONDARY SECTION: Professional Exam Space & Feature Architecture (Below Setup) -->
        <div class="welcome-panel">
          <div class="hero-card glass-panel">
            <div class="hero-header-badge">
              <span class="pulse-dot"></span>
              <span>Visual Time Architecture</span>
            </div>
            <h2>Professional Exam Space</h2>
            <p class="hero-tagline">Realistic exam room visual time manager with intelligent pacing guidance and distraction-free focus.</p>
            
            <div class="minimal-features">
              <span class="feat-badge">⏱️ 5 Analog & Digital Themes</span>
              <span class="feat-badge">🎯 Real-time Pace Assistant</span>
              <span class="feat-badge">🔒 Strict Exam Simulation</span>
              <span class="feat-badge">🔔 Web Audio Chime Alerts</span>
            </div>

            <!-- Instant Fast Start Presets Strip -->
            <div class="fast-start-presets">
              <span class="fast-start-title">Fast Start Presets:</span>
              <div class="fast-preset-chips">
                <button type="button" class="fast-chip" data-hours="1" data-mins="0" data-secs="0">⚡ 1 Hour</button>
                <button type="button" class="fast-chip active" data-hours="2" data-mins="0" data-secs="0">⏱️ 2 Hours (Standard)</button>
                <button type="button" class="fast-chip" data-hours="3" data-mins="0" data-secs="0">🎯 3 Hours (JEE/SAT)</button>
                <button type="button" class="fast-chip pomo" data-hours="0" data-mins="25" data-secs="0">🍅 25m Pomodoro</button>
              </div>
            </div>
          </div>

          <!-- Study mode selection widget -->
          <div class="study-mode-promo glass-panel hidden" id="study-presets-panel">
            <div class="study-promo-header">
              <h4>Study Timer Presets</h4>
              <button type="button" class="text-action-btn" id="exit-study-mode-btn">Exit Study Mode</button>
            </div>
            <p class="promo-desc">Switch to Pomodoro sessions, a stopwatch, or custom countdown study blocks.</p>
            <div class="study-actions-grid">
              <button type="button" class="study-choice-card" data-study="pomodoro-25">
                <span class="study-icon">🍅</span>
                <span class="study-label">Pomodoro</span>
                <span class="study-sub">25m Work / 5m Break</span>
              </button>
              <button type="button" class="study-choice-card" data-study="pomodoro-50">
                <span class="study-icon">⚡</span>
                <span class="study-label">Ultra Pomo</span>
                <span class="study-sub">50m Work / 10m Break</span>
              </button>
              <button type="button" class="study-choice-card" data-study="stopwatch">
                <span class="study-icon">⏱️</span>
                <span class="study-label">Stopwatch</span>
                <span class="study-sub">Count-up Focus Session</span>
              </button>
            </div>
          </div>
        </div>
      </section>

      <!-- SCREEN 2: Active Exam Dashboard -->
      <section id="screen-dashboard" class="layout-split">
        <!-- Visual Centerpiece (Hero Left) -->
        <div class="dashboard-hero-panel glass-panel">
          <!-- Floating Settings Gear to Toggle Controls/Sidebar -->
          <button type="button" id="dashboard-toggle-controls-btn" class="dashboard-fab-btn" title="Toggle Sidebar Controls">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
          </button>

          <div class="status-top-bar">
            <div class="status-indicator">
              <span class="indicator-pulse"></span>
              <span id="dashboard-status-label" class="status-txt">EXAM IN PROGRESS</span>
            </div>
            <span id="pomo-stage-badge" class="pomo-badge hidden">WORK BLOCK</span>
          </div>

          <!-- Large Analog Clock face -->
          <div class="clock-stage">
            <ClockStage />
          </div>

          <!-- Large Precision Digital Display -->
          <div class="digital-clock-container">
            <span id="digital-countdown-time" class="digital-time-digits">02:30:00</span>
            <span class="digital-time-label">Time Remaining</span>
          </div>
        </div>

        <!-- Metric Details & Actions (Sidebar Right) -->
        <div class="dashboard-sidebar-panel">
          
          <!-- Controls Panel -->
          <div class="card-wrapper glass-panel">
            <TimerControls />
          </div>

          <!-- Progress Meters -->
          <div class="card-wrapper glass-panel">
            <ProgressDisplay />
          </div>

          <!-- Pacing Helpers -->
          <QuestionProgress />

          <!-- Active Warnings Banner list inside exam -->
          <div class="warning-toast-host" id="warning-toast-host"></div>
        </div>
      </section>

      <!-- Comprehensive Educational SEO Guide & FAQ Section (For Search Engines & Students) -->
      <section class="seo-guide-container">
        <!-- Section 1: Visual Time Architecture -->
        <article class="seo-card glass-panel">
          <div class="seo-badge">🕒 Temporal Architecture</div>
          <h2>Why Practice with a Visual Analog Exam Timer?</h2>
          <p>
            Standard countdown clocks force candidates to continually perform mental arithmetic (e.g. <em>"I have 47 minutes left for 31 questions—how many seconds per question is that?"</em>). 
            <strong>Exam Timer Online</strong> maps elapsed and remaining duration onto high-contrast angular sweep sectors. This engages peripheral vision and eliminates <strong>time blindness</strong> during high-stakes competitive examinations.
          </p>
          <div class="seo-benefits-grid">
            <div class="benefit-item">
              <div class="b-icon">🧠</div>
              <h4>Prevents Time Blindness</h4>
              <p>Analog hand sweeps let candidates monitor pacing with intuitive peripheral vision without interrupting problem-solving flow.</p>
            </div>
            <div class="benefit-item">
              <div class="b-icon">⏱️</div>
              <h4>Realistic Exam Hall Conditioning</h4>
              <p>Physical test centers (JEE, NEET, SAT, UPSC, Bar Exams) feature wall-mounted clocks. Training with an analog face builds authentic temporal intuition.</p>
            </div>
            <div class="benefit-item">
              <div class="b-icon">🎯</div>
              <h4>Dynamic Question Pacing</h4>
              <p>Real-time calculation alerts you immediately if you fall behind target pace, helping you make quick tactical skipping decisions.</p>
            </div>
          </div>
        </article>

        <!-- Section 2: Standardized Exam Timing Guide Matrix -->
        <article class="seo-card glass-panel">
          <div class="seo-badge">📊 Exam Pacing Matrix</div>
          <h2>Standardized Exam Pacing & Timing Reference</h2>
          <p>Recommended timing benchmarks for prominent national and international competitive examinations:</p>
          
          <div class="table-responsive">
            <table class="exam-matrix-table">
              <thead>
                <tr>
                  <th>Examination</th>
                  <th>Total Duration</th>
                  <th>Total Questions</th>
                  <th>Target Pace / Question</th>
                  <th>Recommended Preset</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <td><strong>JEE Main (Paper 1)</strong></td>
                  <td>180 min (3 Hours)</td>
                  <td>75 Questions</td>
                  <td>~2m 24s / question</td>
                  <td><span class="matrix-badge">3 Hours Strict</span></td>
                </tr>
                <tr>
                  <td><strong>NEET UG</strong></td>
                  <td>200 min (3h 20m)</td>
                  <td>180 Questions</td>
                  <td>~1m 06s / question</td>
                  <td><span class="matrix-badge">High Speed Pace</span></td>
                </tr>
                <tr>
                  <td><strong>Digital SAT</strong></td>
                  <td>134 min (~2h 14m)</td>
                  <td>98 Questions</td>
                  <td>~1m 15s / question</td>
                  <td><span class="matrix-badge">2 Hours Sectional</span></td>
                </tr>
                <tr>
                  <td><strong>UPSC CSE Prelims (GS 1)</strong></td>
                  <td>120 min (2 Hours)</td>
                  <td>100 Questions</td>
                  <td>~1m 12s / question</td>
                  <td><span class="matrix-badge">2 Hours Standard</span></td>
                </tr>
                <tr>
                  <td><strong>CAT (MBA Entrance)</strong></td>
                  <td>120 min (40m/section)</td>
                  <td>66 Questions</td>
                  <td>~1m 49s / question</td>
                  <td><span class="matrix-badge">Sectional Blocks</span></td>
                </tr>
                <tr>
                  <td><strong>GMAT Focus Edition</strong></td>
                  <td>135 min (45m/section)</td>
                  <td>64 Questions</td>
                  <td>~2m 06s / question</td>
                  <td><span class="matrix-badge">Adaptive Strict</span></td>
                </tr>
              </tbody>
            </table>
          </div>
        </article>

        <!-- Section 3: FAQ Accordion -->
        <article class="seo-card glass-panel">
          <div class="seo-badge">❓ Frequently Asked Questions</div>
          <h2>Frequently Asked Questions About Exam Timer Online</h2>
          
          <div class="faq-list">
            <details class="faq-item" open>
              <summary class="faq-question">
                <span>How does Exam Timer Online help simulate real test conditions?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="faq-answer">
                <p>Exam Timer Online replicates physical examination rooms with analog sweep clocks, strict mode (pause-lock), customizable milestone chimes (e.g. at 15m, 10m, and 5m remaining), and a clean distraction-free fullscreen mode that mirrors official test hall conditions.</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>Does the countdown timer keep running if I switch tabs or lose internet?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="faq-answer">
                <p>Yes. The state engine calculates remaining time using true timestamp differentials (Date.now()) instead of fragile interval counters. It runs seamlessly offline via Service Worker Progressive Web App (PWA) caching.</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>Can I customize alarm sounds and milestone warnings?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="faq-answer">
                <p>Yes. You can choose from 6 synthesized tones (Classic Ding-Dong, Digital Beep, School Bell, Siren, Gentle Gong, Fanfare), add custom warning minute marks, and adjust master sound volume in the Settings drawer.</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>What keyboard shortcuts are available?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="faq-answer">
                <p>You can control the clock completely with your keyboard: <strong>Space</strong> (Pause / Resume), <strong>F</strong> (Fullscreen), <strong>M</strong> (Mute / Unmute), <strong>E</strong> (End Exam), <strong>]</strong> or <strong>→</strong> (Next Question), <strong>[</strong> or <strong>←</strong> (Previous Question), and <strong>Esc</strong> (Close modals/drawers).</p>
              </div>
            </details>

            <details class="faq-item">
              <summary class="faq-question">
                <span>Is my exam history saved locally?</span>
                <svg class="faq-chevron" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </summary>
              <div class="faq-answer">
                <p>Yes, all session metrics and summaries are saved locally in your browser's localStorage. No private data is ever sent to any remote server.</p>
              </div>
            </details>
          </div>
        </article>

        <!-- Section 4: Deep-Dive Resources Hub -->
        <article class="seo-card glass-panel hub-card">
          <div class="seo-badge">📚 Academic Timing Hub</div>
          <h2>Specialized Study Timers, Subject Guides & Analysis</h2>
          <p>Explore dedicated study guides, benchmark formulas, and comprehensive timer comparisons built for competitive exams and focused study:</p>
          <div class="hub-grid">
            <a href="/guide" class="hub-link-card">
              <div class="hub-icon">📐</div>
              <div class="hub-body">
                <h3>Subject Practice Timers</h3>
                <p>Calculated pacing techniques for Mathematics, Physics, Chemistry, PYQs & speed drilling.</p>
              </div>
            </a>
            <a href="/comparisons" class="hub-link-card">
              <div class="hub-icon">⚖️</div>
              <div class="hub-body">
                <h3>Exam Timer Comparisons</h3>
                <p>Objective feature matrices: Pomodoro vs Countdown vs Stopwatches vs Phone Timers.</p>
              </div>
            </a>
            <a href="/features" class="hub-link-card">
              <div class="hub-icon">⚡</div>
              <div class="hub-body">
                <h3>Full Feature Catalog</h3>
                <p>5 visual clock themes, Web Audio alarms, strict mode, question pacing & offline PWA.</p>
              </div>
            </a>
            <a href="/how-it-works" class="hub-link-card">
              <div class="hub-icon">🧠</div>
              <div class="hub-body">
                <h3>The Science of Visual Time</h3>
                <p>Why analog sweep angles prevent cognitive overload and combat exam time blindness.</p>
              </div>
            </a>
          </div>
        </article>
      </section>

      <!-- Comprehensive Semantic Footer -->
      <SiteFooter />

    </main>

    <!-- Slide-out Drawers & Modals -->
    <ThemeModal />
    <SettingsPanel />
    
    <!-- History Modal overlay -->
    <div id="history-modal-backdrop" class="modal-backdrop hidden">
      <div class="modal-content glass-panel">
        <div class="modal-header">
          <h3>Local Exam Logs</h3>
          <button type="button" id="history-modal-close" class="close-btn" aria-label="Close history modal">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>
        <div class="modal-body">
          <HistoryPanel />
        </div>
      </div>
    </div>

    <!-- Custom In-App Confirmation Modal (Replaces blocking native confirm) -->
    <div id="app-confirm-dialog" class="modal-backdrop hidden">
      <div class="modal-content glass-panel confirm-dialog-box">
        <div class="confirm-icon-circle" id="confirm-icon-box">⚠️</div>
        <h3 id="confirm-dialog-title">End Exam Session?</h3>
        <p id="confirm-dialog-desc">Are you sure you want to end this session? Your metrics will be logged to History.</p>
        <div class="confirm-dialog-actions">
          <button type="button" id="confirm-cancel-btn" class="btn-dialog-secondary">Cancel / Continue</button>
          <button type="button" id="confirm-accept-btn" class="btn-dialog-primary">Yes, End Exam</button>
        </div>
      </div>
    </div>

    <!-- Fullscreen Dedicated Mode overlay -->
    <div id="fullscreen-exam-overlay" class="fullscreen-overlay hidden">
      <div class="fs-header">
        <div class="fs-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          <span id="fs-exam-name">Mock Test</span>
        </div>
        <div id="fs-status" class="fs-status">Exam In Progress</div>
      </div>

      <div class="fs-clock-stage">
        <div class="fs-clock-scale-wrapper">
          <ClockStage />
        </div>
      </div>

      <div class="fs-footer">
        <div class="fs-digital-area">
          <div id="fs-digital-time" class="fs-digits">02:30:00</div>
          <div class="fs-digits-sub">
            <span id="fs-percent-remaining">100% remaining</span>
            <span class="fs-dot-divider">•</span>
            <span id="fs-ends-time">Ends at 11:30 AM</span>
          </div>
        </div>

        <div class="fs-controls">
          <button type="button" id="fs-play-pause-btn" class="fs-btn primary">Pause</button>
          <button type="button" id="fs-exit-btn" class="fs-btn">Exit Fullscreen</button>
        </div>
      </div>
    </div>

    <!-- PEAK-END RULE: Session Performance Debrief Overlay (Replaces raw alarm modal) -->
    <div id="session-debrief-overlay" class="times-up-overlay hidden">
      <div class="times-up-content glass-panel session-debrief-card">
        <!-- Close dismiss button -->
        <button type="button" class="debrief-close-btn" id="debrief-close-btn" title="Close" aria-label="Close debrief">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>

        <div class="debrief-header">
