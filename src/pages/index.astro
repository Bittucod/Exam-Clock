  /* Big Glowing 'Set Timer' Action Button */
  .btn-set-timer-cta {
    position: relative;
    width: 100%;
    max-width: 440px;
    background: linear-gradient(135deg, var(--brand-accent) 0%, #6366f1 100%);
    border: none;
    border-radius: 1rem;
    padding: 1.15rem 1.4rem;
    cursor: pointer;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
