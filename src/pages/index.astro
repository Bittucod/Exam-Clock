            <span class="debrief-stat-sub" id="debrief-pace-details">Pace managed</span>
          </div>
        </div>

        <!-- Dynamic Action Options -->
        <div class="debrief-actions-stack">
          <div class="debrief-actions-primary-row" id="debrief-primary-actions-row">
            <button type="button" id="debrief-resume-btn" class="btn-debrief-primary hidden" title="Continue this exam session">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              <span>Resume Session</span>
            </button>
            <button type="button" id="debrief-restart-btn" class="btn-debrief-primary" title="Restart this exam">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path></svg>
              <span id="debrief-restart-btn-text">Practice Again</span>
            </button>
            <button type="button" id="debrief-new-setup-btn" class="btn-debrief-secondary" title="Return to setup screen">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
              <span>New Setup</span>
            </button>
          </div>
          <button type="button" id="debrief-history-btn" class="btn-debrief-tertiary" title="Review past exam sessions">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3"></path><circle cx="12" cy="12" r="10"></circle></svg>
            <span>Review History Log</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Fullscreen Flashing warning overlay when timer completes -->
    <div id="times-up-fullscreen-flash" class="fullscreen-flash-overlay hidden"></div>

    <!-- Global Toast Notification Container -->
    <div id="app-toast-container" class="toast-container"></div>

  </div>
</Layout>

<!-- Design system Tokens and custom global rules -->
