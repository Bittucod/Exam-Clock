---
// src/pages/about.astro
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const breadcrumbs = [
  { name: 'About Us', href: '/about' }
];

const aboutSchema = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "About Exam Timer Online",
  "description": "Learn about the mission, research, and educational principles behind Exam Timer Online.",
  "publisher": {
    "@type": "Organization",
    "name": "Exam Timer Online"
  }
};
---

<Layout
  title="About Us — Mission, Educational Philosophy & Cognitive Time Research | Exam Timer Online"
  description="Discover the origin and cognitive research behind Exam Timer Online. Learn why visual analog dials, question pacing targets, and strict mode help students succeed."
  canonical="https://examtimer.online/about"
  breadcrumbs={breadcrumbs}
  customSchema={aboutSchema}
>
  <SiteHeader />

  <main class="page-main-container">

    <!-- Hero Header -->
    <header class="page-hero">
      <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="breadcrumb-separator">/</span>
        <span>About Us</span>
      </nav>
      <span class="page-badge">🏛️ Mission & Research</span>
      <h1>Empowering Confident Test Day Performance</h1>
      <p class="subtitle">
        We believe that no student should fail an exam simply because they lost track of time. Exam Timer Online was built to replace anxiety with instinct.
      </p>
    </header>

    <div class="about-content-stack">
      
      <!-- Origin Story -->
      <section class="about-card glass-panel">
        <h2>Why We Built Exam Timer Online</h2>
        <p>
          Every year, millions of students across the globe prepare rigorously for competitive examinations like <strong>JEE, NEET, SAT, GRE, UPSC, GMAT, and Bar Exams</strong>. They master formulas, memorize thousands of pages of notes, and practice countless textbook problems.
        </p>
        <p>
          Yet on test day, an alarming number of capable candidates underperform by 20% to 40%. The culprit is almost never lack of subject knowledge—it is <strong>temporal breakdown</strong>. Students get trapped on an unexpectedly difficult problem, lose awareness of time, and suddenly discover they have only 10 minutes remaining for 30 questions.
        </p>
        <p>
          Traditional tools failed to address this:
        </p>
        <ul class="about-bullet-list">
          <li><strong>Phone timers</strong> were laden with social media distractions and lock screens.</li>
          <li><strong>Simple digital stopwatches</strong> counted upward indefinitely without conveying deadline pressure.</li>
          <li><strong>Generic timer websites</strong> were cluttered with pop-up banner advertisements and video autoplay interruptions.</li>
        </ul>
        <p>
          We created <strong>Exam Timer Online</strong> to provide a clean, distraction-free, mathematically precise exam space that mirrors real-world test hall wall clocks while equipping candidates with real-time question pacing intelligence.
        </p>
      </section>

      <!-- 4 Core Pillars -->
      <section class="pillars-section">
        <h2 class="section-heading">Our Core Educational Commitments</h2>
        <div class="pillars-grid">
          
          <div class="pillar-card glass-panel">
            <div class="pillar-icon">🆓</div>
            <h3>100% Free Forever</h3>
            <p>Quality educational tools must remain universally accessible to all students regardless of financial background or geographic location. No subscriptions or paywalls.</p>
          </div>

          <div class="pillar-card glass-panel">
            <div class="pillar-icon">🚫</div>
            <h3>Zero Distractions & Ads</h3>
            <p>You will never encounter pop-up ads, autoplay videos, or commercial promotions that disrupt test concentration. Pure focus is non-negotiable.</p>
          </div>

          <div class="pillar-card glass-panel">
            <div class="pillar-icon">🔒</div>
            <h3>Absolute Local Privacy</h3>
            <p>We do not collect student data, use tracking cookies, or require accounts. Your mock test records and settings remain strictly inside your device's LocalStorage.</p>
          </div>

          <div class="pillar-card glass-panel">
            <div class="pillar-icon">⚡</div>
            <h3>100% Offline Resilience</h3>
            <p>Engineered as a Progressive Web App (PWA). Once opened in your browser, the clock runs completely offline on laptops, tablets, or phones with zero internet dependency.</p>
          </div>

        </div>
      </section>

      <!-- Cognitive Research Box -->
      <section class="research-card glass-panel">
        <span class="section-tag">Cognitive Ergonomics</span>
        <h2>The Science of Analog Visual Sweep</h2>
        <p>
          Cognitive psychologists distinguish between <em>focal attention</em> and <em>ambient peripheral awareness</em>. Reading numeric digits (like <code>01:24:19</code>) activates focal prefrontal cortex processing—requiring you to pause mathematical calculation to read and subtract numbers.
        </p>
        <p>
          In contrast, an analog clock's sweeping sector taps into ambient spatial perception. A student can glance out of the corner of their eye and immediately grasp: <em>"A quarter of the circle remains."</em> This preserves working memory and keeps problem-solving momentum intact.
        </p>
      </section>

    </div>

    <!-- Bottom CTA -->
    <section class="cta-banner glass-panel">
      <h2>Train Like It's Test Day</h2>
      <p>Launch your next mock exam session with an authentic visual clock and live pacing targets.</p>
      <a href="/" class="btn-primary-action">
        <span>Open Free Exam Clock</span>
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
      </a>
    </section>

  </main>

  <SiteFooter />
</Layout>

<style>
  .about-content-stack {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .about-card {
    padding: 2.5rem 2.75rem;
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .about-card h2 {
    font-size: clamp(1.45rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    color: var(--text-primary);
    margin: 0;
  }

  .about-card p {
    font-size: 0.98rem;
    line-height: 1.7;
    color: var(--text-muted);
    margin: 0;
  }

  .about-card strong {
    color: var(--text-primary);
  }

  .about-bullet-list {
    margin: 0;
    padding-left: 1.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Pillars */
  .pillars-section {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .section-heading {
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 800;
    text-align: center;
    color: var(--text-primary);
    margin: 0;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.25rem;
  }

  .pillar-card {
    padding: 1.75rem 1.5rem;
    border-radius: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }

  .pillar-icon {
    font-size: 2.25rem;
    margin-bottom: 0.25rem;
  }

  .pillar-card h3 {
    margin: 0;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .pillar-card p {
    margin: 0;
    font-size: 0.88rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Research Card */
  .research-card {
    padding: 2.5rem 2.75rem;
    border-radius: 1.5rem;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, rgba(var(--brand-accent-rgb), 0.06) 100%);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .section-tag {
    font-size: 0.75rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--brand-accent);
  }

  .research-card h2 {
    margin: 0;
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .research-card p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-muted);
  }

  /* CTA Banner */
  .cta-banner {
    text-align: center;
    padding: 3.5rem 2rem;
    border-radius: 1.5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
    background: linear-gradient(180deg, var(--bg-secondary) 0%, rgba(var(--brand-accent-rgb), 0.08) 100%);
  }

  .cta-banner h2 {
    font-size: clamp(1.6rem, 3.5vw, 2.25rem);
    font-weight: 800;
    margin: 0;
    color: var(--text-primary);
  }

  .cta-banner p {
    font-size: 1.05rem;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 0 0.5rem;
  }

  @media (max-width: 768px) {
    .about-card, .research-card {
      padding: 1.75rem 1.5rem;
    }
  }
</style>
