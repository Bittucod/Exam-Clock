---
// src/pages/faq.astro
import Layout from '../layouts/Layout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const breadcrumbs = [
  { name: 'FAQ', href: '/faq' }
];

const faqs = [
  {
    category: "Exam Simulation & Timer Mechanics",
    q: "How does Exam Timer Online eliminate exam day 'time blindness'?",
    a: "Standard digital countdowns force candidates to continually perform mental arithmetic to estimate how much time is left. Exam Timer Online renders an authentic visual analog clock face with angular sector sweeps, allowing candidates to estimate remaining time through peripheral vision without interrupting problem-solving concentration."
  },
  {
    category: "Exam Simulation & Timer Mechanics",
    q: "Does the timer keep running accurately if I switch browser tabs, lock my screen, or go offline?",
    a: "Yes, 100%. The timing engine calculates remaining duration by comparing against absolute UTC system timestamps rather than relying on browser setInterval ticks (which browsers throttle to save battery). When you switch tabs or awaken your device, the clock renders the exact millisecond-accurate time instantly."
  },
  {
    category: "Exam Simulation & Timer Mechanics",
    q: "What is Strict Exam Mode and when should I use it?",
    a: "Strict Exam Mode locks out the pause button and spacebar pause hotkey once the test begins. In real test centers (JEE, NEET, SAT, UPSC, Bar Exams), invigilators never pause the clock. Enabling Strict Mode prevents the bad habit of pausing when faced with difficult questions, training genuine cognitive resilience."
  },
  {
    category: "Question Pacing Assistant",
    q: "How does the Question Pacing Assistant calculate if I am ahead or behind schedule?",
    a: "When you input your total question count, the engine divides your total session seconds by the question count to determine the exact average seconds per question. At any second, it calculates which question you should currently be on and compares it to your active question counter, displaying whether you are Ahead of Schedule, On Track, or Behind Schedule."
  },
  {
    category: "Question Pacing Assistant",
    q: "Can I adjust my question number during the exam without using the mouse?",
    a: "Yes. You can press the right bracket key (']') or plus ('+') to advance to the next question, and the left bracket ('[') or minus ('-') to decrement. This keeps your hands on your keyboard and scratch paper."
  },
  {
    category: "Audio & Alerts",
    q: "Will an annoying alarm sound if I voluntarily stop or reset my mock exam early?",
    a: "No. The continuous alarm loop is strictly programmed to trigger only when the timer naturally expires at 00:00:00. If you finish early or reset, a gentle confirmation tone plays and the alarm loop remains completely silent."
  },
  {
    category: "Audio & Alerts",
    q: "How do I instantly silence the completion alarm when time runs out?",
    a: "When the exam timer reaches zero, a prominent 'Silence Alarm' button appears directly in the session debrief modal. Clicking it, clicking the close button, pressing Escape, or clicking outside immediately mutes the sound."
  },
  {
    category: "Audio & Alerts",
    q: "What synthesized alarm sound options are available?",
    a: "You can select from 6 mathematically synthesized Web Audio options in the Settings drawer: Classic Ding-Dong chime, Digital Electronic Beeps, Traditional School Bell, Urgent Alert Siren, Deep Gentle Gong, and Triumphant Fanfare."
  },
  {
    category: "Privacy & Device Compatibility",
    q: "Is Exam Timer Online free? Are there any ads or subscription fees?",
    a: "Exam Timer Online is 100% free with no subscription tiers, no hidden paywalls, and no intrusive video or banner ads that distract students."
  },
  {
    category: "Privacy & Device Compatibility",
    q: "Do you collect any student data or use tracking cookies?",
    a: "No. We use zero tracking cookies and collect no personal information. All your exam history records, custom presets, warning preferences, and theme choices are stored locally in your browser's private LocalStorage."
  },
  {
    category: "Privacy & Device Compatibility",
    q: "Can I install Exam Timer Online as an application on my computer or tablet?",
    a: "Yes! Exam Timer Online is a verified Progressive Web App (PWA). In Chrome, Edge, or Safari, click the 'Install App' icon in the address bar to install it directly onto Windows, macOS, ChromeOS, iPadOS, or Android for full offline standalone use."
  },
  {
    category: "Subject Practice",
    q: "Can I use this timer for Mathematics, Physics, and Chemistry practice?",
    a: "Yes. The timer features dedicated presets and pacing tools tailored for STEM numerical problem solving, chemistry speed-banking, and full-length Previous Year Question (PYQ) paper simulations."
  }
];

const faqPageSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(item => ({
    "@type": "Question",
    "name": item.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": item.a
    }
  }))
};
---

<Layout
  title="FAQ — Frequently Asked Questions & Troubleshooting | Exam Timer Online"
  description="Find answers to common questions about Exam Timer Online: timing accuracy, offline functionality, question pacing calculations, audio alerts, and privacy."
  canonical="https://examtimer.online/faq"
  keywords="exam timer faq, online exam clock help, question pacing instructions, offline pwa timer, mock test clock troubleshooting"
  breadcrumbs={breadcrumbs}
  customSchema={faqPageSchema}
>
  <SiteHeader />

  <main class="page-main-container">

    <!-- Hero Header -->
    <header class="page-hero">
      <nav class="breadcrumb-nav" aria-label="Breadcrumbs">
        <a href="/">Home</a>
        <span class="breadcrumb-separator">/</span>
        <span>FAQ</span>
      </nav>
      <span class="page-badge">❓ Knowledge Base</span>
      <h1>Frequently Asked Questions</h1>
      <p class="subtitle">
        Everything you need to know about using Exam Timer Online for competitive tests, classroom timekeeping, and speed practice.
      </p>

      <!-- Client-side Search Input -->
      <div class="faq-search-wrapper">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="search-icon"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
        <input type="text" id="faq-search-input" placeholder="Search questions (e.g. offline, alarm, strict mode)..." aria-label="Search frequently asked questions" />
      </div>
    </header>

    <!-- FAQ Accordion List -->
    <section class="faq-list-section">
      <div class="faq-list" id="faq-list">
        {faqs.map((faq, index) => (
          <details class="faq-item glass-panel" open={index === 0}>
            <summary>
              <div class="summary-left">
                <span class="faq-category-tag">{faq.category}</span>
                <span class="faq-question-text">{faq.q}</span>
              </div>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))}
      </div>
    </section>

    <!-- Still have questions? Contact Box -->
    <section class="contact-prompt glass-panel">
      <div class="prompt-icon">💬</div>
      <div class="prompt-content">
        <h3>Still have a question or spotted a bug?</h3>
        <p>Our team is committed to making Exam Timer Online the cleanest educational clock on the web.</p>
      </div>
      <a href="/contact" class="btn-primary-action">
        <span>Report Problem / Contact Us</span>
      </a>
    </section>

  </main>

  <SiteFooter />
</Layout>

<script>
  const searchInput = document.getElementById('faq-search-input') as HTMLInputElement | null;
  const faqItems = document.querySelectorAll('.faq-item') as NodeListOf<HTMLDetailsElement>;

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value.toLowerCase().trim();

    faqItems.forEach(item => {
      const qText = item.querySelector('.faq-question-text')?.textContent?.toLowerCase() || '';
      const aText = item.querySelector('.faq-answer')?.textContent?.toLowerCase() || '';
      const catText = item.querySelector('.faq-category-tag')?.textContent?.toLowerCase() || '';

      if (!query || qText.includes(query) || aText.includes(query) || catText.includes(query)) {
        item.style.display = 'block';
        if (query) item.open = true;
      } else {
        item.style.display = 'none';
      }
    });
  });
</script>

<style>
  .faq-search-wrapper {
    position: relative;
    width: 100%;
    max-width: 580px;
    margin-top: 1rem;
  }

  .faq-search-wrapper .search-icon {
    position: absolute;
    left: 1.15rem;
    top: 50%;
    transform: translateY(-50%);
    color: var(--text-muted);
    pointer-events: none;
  }

  #faq-search-input {
    width: 100%;
    padding: 0.95rem 1.25rem 0.95rem 3rem;
    font-family: inherit;
    font-size: 0.95rem;
    color: var(--text-primary);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 9999px;
    outline: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  #faq-search-input:focus {
    border-color: var(--brand-accent);
    box-shadow: 0 0 0 4px rgba(var(--brand-accent-rgb), 0.15);
  }

  /* FAQ List */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 900px;
    margin: 0 auto;
  }

  .faq-item {
    border-radius: 1rem;
    padding: 1.25rem 1.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .faq-item:hover {
    border-color: var(--border-hover);
  }

  .faq-item summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-item summary::after {
    content: '+';
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--brand-accent);
    flex-shrink: 0;
  }

  .faq-item[open] summary::after {
    content: '−';
  }

  .summary-left {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    text-align: left;
  }

  .faq-category-tag {
    font-size: 0.72rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--brand-accent);
  }

  .faq-question-text {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.45;
  }

  .faq-answer {
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-color);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--text-muted);
  }

  .faq-answer p {
    margin: 0;
  }

  /* Contact Prompt Box */
  .contact-prompt {
    max-width: 900px;
    margin: 1.5rem auto 0;
    padding: 2rem 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    border-radius: 1.25rem;
    background: linear-gradient(135deg, var(--bg-secondary) 0%, rgba(var(--brand-accent-rgb), 0.08) 100%);
  }

  .prompt-icon {
    font-size: 2.5rem;
  }

  .prompt-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .prompt-content h3 {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 800;
    color: var(--text-primary);
  }

  .prompt-content p {
    margin: 0;
    font-size: 0.88rem;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .contact-prompt {
      flex-direction: column;
      text-align: center;
      padding: 1.75rem 1.25rem;
    }
    .faq-item {
      padding: 1.1rem 1.25rem;
    }
  }
</style>
